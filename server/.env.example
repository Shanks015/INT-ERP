# Server environment variables
# Copy to .env and fill in real values. Never commit .env.

PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Credential Encryption (AES-256) — 32-byte key
ENCRYPTION_KEY=

# SMTP — Outreach reminder email sender
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ADMIN_EMAIL=

# Google Forms webhook shared secret.
# The Apps Script attached to each Google Form must send this value as either
# the X-Webhook-Token header or a ?token= query param.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WHILE THIS IS UNSET the /api/google-forms/webhook endpoint accepts
# unauthenticated writes and logs a warning on every request. Set it as soon as
# the Apps Script has been updated with the matching token.
GOOGLE_FORMS_WEBHOOK_SECRET=

# ERP Drive — per-record file uploads (#113). Files live in ONE office Google
# Drive account; the server acts as it for every call. Set exactly ONE credential
# source below, or the per-record Files modal stays inert ("not configured").
# Both sources reuse the Google OAuth project that mailboxes use, so the Drive
# API must be enabled for that project (Cloud Console → APIs & Services → Library).
#
# Option A (recommended, mirrors mail): a refresh token minted once by signing in
# as the office account. One Cloud Console step first (enable the Drive API and
# register the redirect URI http://localhost:5312/oauth2callback on the OAuth
# client), then run once:
#     cd server && node scripts/drive_connect.mjs
# and paste the printed token here. The token never expires on its own; if the
# office account ever changes, just re-run the helper and replace the value.
#
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (the same OAuth client the mailboxes
# use) are required for Option A. They default from the shared ERP client when
# unset — only override if the project changes.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_DRIVE_REFRESH_TOKEN=
#
# Daily Sheets backup — one Google Sheet ("ERP Data Backup") inside ERP-Automation,
# one tab per business module. Runs once a day (default 03:00 IST) so ERP edits
# land on the sheet on the next run (~within a day). Requires the Drive refresh
# token to include the spreadsheets scope (re-run drive_connect.mjs after
# enabling the Sheets API). Set SHEET_BACKUP_ENABLED=false to turn the job off.
#SHEET_BACKUP_ENABLED=true
#SHEET_BACKUP_CRON=0 3 * * *
#SHEET_BACKUP_TIMEZONE=Asia/Kolkata
#SHEET_BACKUP_SPREADSHEET_NAME=ERP Data Backup
#
# Option B (Google Workspace only): a service-account key + domain-wide
# delegation, so nobody ever clicks Allow. Put the JSON key inline, or in a file
# the server can read, and set GOOGLE_DRIVE_IMPERSONATE to the office address to
# act as. Grant the delegation in Google Admin for BOTH scopes:
#     https://www.googleapis.com/auth/drive
#     https://www.googleapis.com/auth/spreadsheets
#
#GOOGLE_DRIVE_SERVICE_ACCOUNT={"type":"service_account",...}
#GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/run/secrets/drive-service-account.json
#GOOGLE_DRIVE_IMPERSONATE=office@example.edu
